<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción -->
    <record id="alumne_action" model="ir.actions.act_window">
        <field name="name">Alumnos</field>
        <field name="res_model">ciclo.alumne</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="alumne_menu" name="Alumnos" 
              parent="ciclos_formativos_menu_root" 
              action="alumne_action" 
              sequence="30"/>

    <!-- Vista Formulario -->
    <record id="alumne_view_form" model="ir.ui.view">
        <field name="name">ciclo.alumne.form</field>
        <field name="model">ciclo.alumne</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="apellidos"/>
                            <field name="nombre_completo" readonly="1"/>
                            <field name="dni"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="telefono"/>
                            <field name="fecha_nacimiento"/>
                            <field name="num_moduls" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Módulos matriculados">
                            <field name="modul_ids">
                                <tree>
                                    <field name="codigo"/>
                                    <field name="nombre"/>
                                    <field name="ciclo_id"/>
                                    <field name="curso"/>
                                    <field name="professor_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Lista -->
    <record id="alumne_view_tree" model="ir.ui.view">
        <field name="name">ciclo.alumne.tree</field>
        <field name="model">ciclo.alumne</field>
        <field name="arch" type="xml">
            <tree>
                <field name="dni"/>
                <field name="nombre_completo"/>
                <field name="email"/>
                <field name="telefono"/>
                <field name="num_moduls"/>
            </tree>
        </field>
    </record>

    <!-- Vista Búsqueda -->
    <record id="alumne_view_search" model="ir.ui.view">
        <field name="name">ciclo.alumne.search</field>
        <field name="model">ciclo.alumne</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="apellidos"/>
                <field name="dni"/>
                <field name="email"/>
            </search>
        </field>
    </record>

</odoo>
