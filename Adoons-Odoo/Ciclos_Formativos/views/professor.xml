<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción -->
    <record id="professor_action" model="ir.actions.act_window">
        <field name="name">Profesores</field>
        <field name="res_model">ciclo.professor</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="professor_menu" name="Profesores" 
              parent="ciclos_formativos_menu_root" 
              action="professor_action" 
              sequence="40"/>

    <!-- Vista Formulario -->
    <record id="professor_view_form" model="ir.ui.view">
        <field name="name">ciclo.professor.form</field>
        <field name="model">ciclo.professor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="apellidos"/>
                            <field name="nombre_completo" readonly="1"/>
                            <field name="dni"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="telefono"/>
                            <field name="especialidad"/>
                            <field name="num_moduls" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Módulos que imparte">
                            <field name="modul_ids">
                                <tree>
                                    <field name="codigo"/>
                                    <field name="nombre"/>
                                    <field name="ciclo_id"/>
                                    <field name="curso"/>
                                    <field name="horas"/>
                                    <field name="num_alumnes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Lista -->
    <record id="professor_view_tree" model="ir.ui.view">
        <field name="name">ciclo.professor.tree</field>
        <field name="model">ciclo.professor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="dni"/>
                <field name="nombre_completo"/>
                <field name="especialidad"/>
                <field name="email"/>
                <field name="telefono"/>
                <field name="num_moduls"/>
            </tree>
        </field>
    </record>

    <!-- Vista Búsqueda -->
    <record id="professor_view_search" model="ir.ui.view">
        <field name="name">ciclo.professor.search</field>
        <field name="model">ciclo.professor</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="apellidos"/>
                <field name="dni"/>
                <field name="email"/>
                <field name="especialidad"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_especialidad" string="Especialidad" context="{'group_by':'especialidad'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
