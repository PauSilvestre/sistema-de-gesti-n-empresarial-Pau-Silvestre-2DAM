<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         ACCIÓN DEL MODELO SOCIO
         ====================================================== -->
    <record id="biblioteca_socio_action" model="ir.actions.act_window">
        <field name="name">Socios</field>
        <field name="res_model">biblioteca.socio</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ======================================================
         MENÚ PARA SOCIOS
         ====================================================== -->
    <menuitem name="Socios"
              id="biblioteca_socio_menu"
              parent="biblioteca_base_menu"
              action="biblioteca_socio_action"
              sequence="20"/>

    <!-- ======================================================
         VISTA FORMULARIO SOCIO
         ====================================================== -->
    <record id="biblioteca_socio_view_form" model="ir.ui.view">
        <field name="name">Formulario Socio</field>
        <field name="model">biblioteca.socio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="apellido"/>
                        </group>
                        <group>
                            <field name="identificador"/>
                            <field name="nombre_completo" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Ejemplares prestados">
                            <field name="ejemplar_ids">
                                <tree>
                                    <field name="codigo"/>
                                    <field name="comic_nombre"/>
                                    <field name="fecha_prestamo"/>
                                    <field name="fecha_devolucion_prevista"/>
                                    <field name="estado"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================================================
         VISTA LISTA SOCIO
         ====================================================== -->
    <record id="biblioteca_socio_view_tree" model="ir.ui.view">
        <field name="name">Lista de Socios</field>
        <field name="model">biblioteca.socio</field>
        <field name="arch" type="xml">
            <tree>
                <field name="identificador"/>
                <field name="nombre"/>
                <field name="apellido"/>
                <field name="nombre_completo"/>
            </tree>
        </field>
    </record>

    <!-- ======================================================
         VISTA DE BÚSQUEDA SOCIO
         ====================================================== -->
    <record id="biblioteca_socio_view_search" model="ir.ui.view">
        <field name="name">Búsqueda Socios</field>
        <field name="model">biblioteca.socio</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="apellido"/>
                <field name="identificador"/>
            </search>
        </field>
    </record>

</odoo>
