<odoo>
    <!-- report pdf: pendientes por empleado -->
    <record id="action_report_repartiments_pendents" model="ir.actions.report">
        <field name="name">repartiments pendents</field>
        <field name="model">repartiment.empleat</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">Empresa_Repartidors.report_repartiments_pendents</field>
        <field name="report_file">Empresa_Repartidors.report_repartiments_pendents</field>
        <field name="binding_model_id" ref="model_repartiment_empleat"/>
        <field name="binding_type">report</field>
    </record>

    <!-- plantilla qweb -->
    <template id="report_repartiments_pendents">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="empleat">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1 style="text-align:center;">repartiments pendents d'eixida</h1>
                        <h3>empleat: <t t-esc="empleat.nom"/> <t t-esc="empleat.cognom"/></h3>
                        <h4>dni: <t t-esc="empleat.dni"/></h4>

                        <table class="table table-bordered" style="margin-top:20px;">
                            <thead>
                                <tr>
                                    <th>codi</th>
                                    <th>data recepcio</th>
                                    <th>urgencia</th>
                                    <th>client</th>
                                    <th>vehicle</th>
                                    <th>km</th>
                                    <th>receptor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="empleat.repartiment_ids.filtered(lambda r: r.estat == 'no_ha_eixit')" t-as="rep">
                                    <tr>
                                        <td><t t-esc="rep.codi"/></td>
                                        <td><t t-esc="rep.data_recepcio"/></td>
                                        <td><t t-esc="rep.urgencia"/></td>
                                        <td><t t-esc="rep.client_id.nom"/></td>
                                        <td><t t-esc="rep.vehicle_id.tipus"/></td>
                                        <td><t t-esc="rep.kilometres"/></td>
                                        <td><t t-esc="rep.receptor_nom"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-if="not empleat.repartiment_ids.filtered(lambda r: r.estat == 'no_ha_eixit')">
                            <p style="text-align:center; margin-top:30px;">
                                <em>no hi ha repartiments pendents d'eixida</em>
                            </p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
