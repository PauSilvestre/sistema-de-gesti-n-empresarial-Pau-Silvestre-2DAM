<odoo>
    <!-- accion y menu -->
    <record id="client_action" model="ir.actions.act_window">
        <field name="name">clients</field>
        <field name="res_model">repartiment.client</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="clients" id="repartiment_client_menu"
              parent="repartiment_base_menu" action="client_action" sequence="30"/>

    <!-- formulario -->
    <record id="client_view_form" model="ir.ui.view">
        <field name="name">client.form</field>
        <field name="model">repartiment.client</field>
        <field name="arch" type="xml">
            <form string="fitxa client">
                <sheet>
                    <group>
                        <field name="dni"/>
                        <field name="nom"/>
                        <field name="cognom"/>
                        <field name="telefon"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- lista editable -->
    <record id="client_view_list" model="ir.ui.view">
        <field name="name">client.list</field>
        <field name="model">repartiment.client</field>
        <field name="arch" type="xml">
            <tree string="clients" editable="bottom">
                <field name="dni"/>
                <field name="nom"/>
                <field name="cognom"/>
                <field name="telefon"/>
            </tree>
        </field>
    </record>
</odoo>
