<odoo>
    <!-- accion y menus -->
    <record id="empleat_action" model="ir.actions.act_window">
        <field name="name">empleats</field>
        <field name="res_model">repartiment.empleat</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>

    <menuitem name="repartiments" id="repartiment_base_menu"/>
    <menuitem name="empleats" id="repartiment_empleat_menu"
              parent="repartiment_base_menu" action="empleat_action" sequence="10"/>

    <!-- formulario -->
    <record id="empleat_view_form" model="ir.ui.view">
        <field name="name">empleat.form</field>
        <field name="model">repartiment.empleat</field>
        <field name="arch" type="xml">
            <form string="fitxa empleat">
                <sheet>
                    <group>
                        <group>
                            <field name="nom"/>
                            <field name="cognom"/>
                            <field name="dni"/>
                            <field name="telefon"/>
                        </group>
                        <group>
                            <field name="foto" widget="image" class="oe_avatar"/>
                            <field name="carnet_ciclomotor"/>
                            <field name="carnet_furgoneta"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="repartiments">
                            <field name="repartiment_ids">
                                <tree>
                                    <field name="codi"/>
                                    <field name="data_recepcio"/>
                                    <field name="estat"/>
                                    <field name="urgencia"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- lista -->
    <record id="empleat_view_list" model="ir.ui.view">
        <field name="name">empleat.list</field>
        <field name="model">repartiment.empleat</field>
        <field name="arch" type="xml">
            <tree string="empleats">
                <field name="nom"/>
                <field name="cognom"/>
                <field name="dni"/>
                <field name="telefon"/>
                <field name="carnet_ciclomotor"/>
                <field name="carnet_furgoneta"/>
            </tree>
        </field>
    </record>

    <!-- kanban -->
    <record id="empleat_view_kanban" model="ir.ui.view">
        <field name="name">empleat.kanban</field>
        <field name="model">repartiment.empleat</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="nom"/>
                <field name="cognom"/>
                <field name="foto"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <img t-att-src="'/web/image/repartiment.empleat/' + record.id.raw_value + '/foto'"
                                 alt="foto" style="max-width:64px;max-height:64px;"/>
                            <div>
                                <strong><field name="nom"/> <field name="cognom"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
