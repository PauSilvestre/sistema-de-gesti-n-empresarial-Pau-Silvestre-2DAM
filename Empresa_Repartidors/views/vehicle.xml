<odoo>
    <!-- accion y menu -->
    <record id="vehicle_action" model="ir.actions.act_window">
        <field name="name">vehicles</field>
        <field name="res_model">repartiment.vehicle</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>

    <menuitem name="vehicles" id="repartiment_vehicle_menu"
              parent="repartiment_base_menu" action="vehicle_action" sequence="20"/>

    <!-- formulario -->
    <record id="vehicle_view_form" model="ir.ui.view">
        <field name="name">vehicle.form</field>
        <field name="model">repartiment.vehicle</field>
        <field name="arch" type="xml">
            <form string="fitxa vehicle">
                <sheet>
                    <group>
                        <group>
                            <field name="tipus"/>
                            <field name="matricula"/>
                        </group>
                        <group>
                            <field name="foto" widget="image" class="oe_avatar"/>
                            <field name="descripcio"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- lista -->
    <record id="vehicle_view_list" model="ir.ui.view">
        <field name="name">vehicle.list</field>
        <field name="model">repartiment.vehicle</field>
        <field name="arch" type="xml">
            <tree string="vehicles">
                <field name="tipus"/>
                <field name="matricula"/>
                <field name="descripcio"/>
            </tree>
        </field>
    </record>

    <!-- kanban -->
    <record id="vehicle_view_kanban" model="ir.ui.view">
        <field name="name">vehicle.kanban</field>
        <field name="model">repartiment.vehicle</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="tipus"/>
                <field name="matricula"/>
                <field name="foto"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <img t-att-src="'/web/image/repartiment.vehicle/' + record.id.raw_value + '/foto'"
                                 alt="foto" style="max-width:64px;max-height:64px;"/>
                            <div>
                                <strong><field name="tipus"/></strong>
                                <div><field name="matricula"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
