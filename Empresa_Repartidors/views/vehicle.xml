<!-- vistes per al model vehicle -->
<odoo>
    <!-- accio que obre les vistes de vehicles -->
    <record id="vehicle_action" model="ir.actions.act_window">
        <field name="name">vehicles</field>
        <field name="res_model">repartiment.vehicle</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!-- submenu vehicles -->
    <menuitem name="vehicles" id="repartiment_vehicle_menu"
              parent="repartiment_base_menu" action="vehicle_action" sequence="20"/>

    <!-- formulari vehicle -->
    <record id="vehicle_view_form" model="ir.ui.view">
        <field name="name">formulari vehicle</field>
        <field name="model">repartiment.vehicle</field>
        <field name="arch" type="xml">
            <form string="fitxa vehicle">
                <sheet>
                    <group>
                        <group>
                            <field name="tipus"/>
                            <field name="matricula"/>
                        </group>
                        <group>
                            <field name="foto" widget="image" class="oe_avatar"/>
                            <field name="descripcio"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- llista vehicles -->
    <record id="vehicle_view_list" model="ir.ui.view">
        <field name="name">llista vehicles</field>
        <field name="model">repartiment.vehicle</field>
        <field name="arch" type="xml">
            <list string="vehicles">
                <field name="tipus"/>
                <field name="matricula"/>
                <field name="descripcio"/>
            </list>
        </field>
    </record>

    <!-- kanban vehicles -->
    <record id="vehicle_view_kanban" model="ir.ui.view">
        <field name="name">kanban vehicles</field>
        <field name="model">repartiment.vehicle</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="tipus"/>
                <field name="matricula"/>
                <field name="foto"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('repartiment.vehicle', 'foto', record.id.raw_value)"
                                     class="oe_kanban_avatar" alt="foto"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="tipus"/></strong>
                                <div><field name="matricula"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
