<odoo>
    <!-- formulario del wizard -->
    <record id="repartiment_wizard_form" model="ir.ui.view">
        <field name="name">repartiment.wizard.form</field>
        <field name="model">repartiment.repartiment.wizard</field>
        <field name="arch" type="xml">
            <form string="crear repartiment rapid">
                <sheet>
                    <group>
                        <group>
                            <field name="empleat_id"/>
                            <field name="vehicle_id"/>
                            <field name="client_id"/>
                        </group>
                        <group>
                            <field name="data_recepcio"/>
                            <field name="kilometres"/>
                            <field name="urgencia"/>
                            <field name="receptor_nom"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="crear" name="action_crear_repartiment"
                            type="object" class="btn-primary"/>
                    <button string="cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- accion modal -->
    <record id="action_wizard_repartiment" model="ir.actions.act_window">
        <field name="name">crear repartiment (wizard)</field>
        <field name="res_model">repartiment.repartiment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_wizard_repartiment" name="crear repartiment (wizard)"
              parent="repartiment_base_menu" action="action_wizard_repartiment" sequence="50"/>
</odoo>
